--!strict
-- The workflows and composite actions as this checkout's YAML states them: every .yml and .yaml in
-- .github/workflows, and .github/actions/<id>/action.yml. A workflow's id is its file stem, an
-- action's its folder. Nothing here is recorded by hand; the war room's TOML refers to these.
local diagnostics = require './diagnostics'
local fs = require '@dream/fs'
local yaml = require '@jess/yaml'

-- The forge needs to know whether the file wrote a mapping or a sequence, which a Lua table can't
-- say; @jess/yaml's layout can. A jess without it can't run the forge correctly, so it doesn't run.
local decodeWithLayout: (string) -> (unknown, yaml.Layout) = (yaml :: any).decodeWithLayout
  or error('the forge needs a jess whose @jess/yaml has decodeWithLayout (jess newer than 0.3.0)', 0)

export type Layout = yaml.Layout

export type Job = { needs: { string }, document: { [string]: unknown } }

export type Workflow = {
  id: string,
  path: string,
  name: string,
  callable: boolean,
  action: boolean,
  jobs: { [string]: Job },
  -- An action's steps, in order; a workflow has none of its own.
  steps: { { [string]: unknown } },
  document: { [string]: unknown },
  -- Which tables of `document` the file wrote as mappings and which as sequences.
  layout: Layout,
}

local WorkflowFolder = '.github/workflows'
local ActionFolder = '.github/actions'

--- The repository-relative paths of every workflow and action file, sorted bytewise.
local function paths(report: diagnostics.Report, root: string): { string }
  local found = {}
  local names, problem = fs.list(fs.join(root, WorkflowFolder))
  if not names then
    diagnostics.add(report, 'FORGE-E001', WorkflowFolder, problem or 'unreadable')
  else
    for _, name in names do
      local extension = fs.extension(name)
      local path = `{WorkflowFolder}/{name}`
      -- Every .yml and .yaml, files or not: a folder named build.yml fails to read, as it did in the Rust.
      if extension == 'yml' or extension == 'yaml' then table.insert(found, path) end
    end
  end

  local actions, actionProblem = fs.list(fs.join(root, ActionFolder))
  if not actions then
    diagnostics.add(report, 'FORGE-E001', ActionFolder, actionProblem or 'unreadable')
  else
    for _, name in actions do
      local path = `{ActionFolder}/{name}/action.yml`
      if fs.isFile(fs.join(root, path)) then table.insert(found, path) end
    end
  end

  -- As Rust sorted the PathBufs: component by component, so `a/action.yml` comes before
  -- `a-b/action.yml` although `-` sorts before `/` as a byte.
  table.sort(found, function(left: string, right: string): boolean
    return (string.gsub(left, '/', '\0')) < (string.gsub(right, '/', '\0'))
  end)

  return found
end

-- How serde_yaml saw a decoded value, which is what the Rust war room held the YAML to. @jess/yaml's
-- layout gives every mapping and sequence an entry; the one table without one is the
-- `{ tag, value }` @jess/yaml makes of a tagged node.
export type Kind = 'mapping' | 'sequence' | 'tagged' | 'scalar'

local function kind(layout: Layout, value: unknown): Kind
  if type(value) ~= 'table' then return 'scalar' end

  local entry = layout[value]
  if not entry then return 'tagged' end

  return if entry.keys then 'mapping' else 'sequence'
end

--- `value` without its tags. serde_yaml read through a tag everywhere the Rust looked (get, as_str,
--- as_sequence, and deserializing into a map, struct or Vec); only `needs`, matched on the raw value,
--- saw it.
local function untag(layout: Layout, value: unknown): unknown
  while kind(layout, value) == 'tagged' do
    value = (value :: { value: unknown }).value
  end

  return value
end

local function absent(value: unknown): boolean return value == nil or value == jess.null end

--- A mapping serde would deserialize into a map keyed by strings or a struct: a mapping whose keys
--- are all strings, through any tag.
local function isMapping(layout: Layout, value: unknown): boolean
  value = untag(layout, value)
  if kind(layout, value) ~= 'mapping' then return false end

  for key in value :: { [unknown]: unknown } do
    if type(key) ~= 'string' then return false end
  end

  return true
end

--- A sequence, through any tag.
local function isSequence(layout: Layout, value: unknown): boolean
  return kind(layout, untag(layout, value)) == 'sequence'
end

-- What serde_yaml's Value::get reads a key from: any mapping, through its tags, whatever its other
-- keys are. Only the containers the Rust read with get (the document, `on`, `workflow_call`, `runs`,
-- a step) go through this; the fields serde deserialized into maps and structs use isMapping.
local function lookup(layout: Layout, value: unknown): { [string]: unknown }?
  value = untag(layout, value)
  if kind(layout, value) ~= 'mapping' then return nil end

  return value :: { [string]: unknown }
end

local function mapping(layout: Layout, value: unknown): { [string]: unknown }?
  if not isMapping(layout, value) then return nil end

  return untag(layout, value) :: { [string]: unknown }
end

--- The job names `needs` lists, or nil when it isn't a name or a list of names. The Rust matched
--- the raw value here, so a tag on `needs` is refused, but a tag on a name inside it is read through.
local function needed(layout: Layout, value: unknown): { string }?
  if absent(value) then return {} end
  if type(value) == 'string' then return { value } end
  if kind(layout, value) ~= 'sequence' then return nil end

  local out = {}
  for _, listed in value :: { unknown } do
    local name = untag(layout, listed)
    if type(name) ~= 'string' then return nil end
    table.insert(out, name)
  end

  return out
end

--- The keys of `value`, sorted, so whatever walks them reports in the same order every run.
local function sortedKeys(value: { [string]: unknown }): { string }
  local keys = {}
  for key in value do
    table.insert(keys, key)
  end
  table.sort(keys)

  return keys
end

-- serde_yaml_ng's limits, which the Rust met before it read a key: 128 nested collections, counted
-- through aliases, and alias jumps over the whole expanded document of at most 100 per parser
-- event. @jess/yaml keeps an alias as the anchored table itself, never a copy, so the forge counts
-- both without expanding anything: an alias is any occurrence of a table after its first in
-- document order, and each table's jumps and depth are worked out once. A scalar alias decodes to a
-- plain value and can't be told apart, so it counts as one event and no jump; that only moves the
-- threshold, by at most one jump per scalar alias.
local MaxDepth = 128
local JumpsPerEvent = 100

type Budget = { events: number, jumps: number, depth: number }

local function budget(layout: Layout, root: unknown): Budget
  -- The tables in document order, each child edge marked as an alias or not.
  local seen: { [unknown]: boolean } = {}
  local edges: { [unknown]: { { child: unknown, alias: boolean } } } = {}
  local events = 4

  local function children(value: unknown): { unknown }
    local out = {}
    local nodeKind = kind(layout, value)
    if nodeKind == 'tagged' then return { (value :: { value: unknown }).value } end

    if nodeKind == 'sequence' then
      for _, element in value :: { unknown } do
        table.insert(out, element)
      end
    elseif nodeKind == 'mapping' then
      for _, key in layout[value].keys :: { unknown } do
        table.insert(out, key)
        table.insert(out, (value :: { [unknown]: unknown })[key])
      end
    end

    return out
  end

  local function visit(value: unknown)
    if type(value) ~= 'table' then
      events += 1
      return
    end

    local tagged = kind(layout, value) == 'tagged'
    if not tagged then
      seen[value] = true
      events += 2
    end

    local list = {}
    for _, child in children(value) do
      local alias = type(child) == 'table' and seen[child] == true and kind(layout, child) ~= 'tagged'
      table.insert(list, { child = child, alias = alias })
      if alias then
        events += 1
      else
        visit(child)
      end
    end
    edges[value] = list
  end
  visit(root)

  -- Jumps and depth over the expansion, once per table; a table met again while it's still being
  -- worked out is an alias to its own ancestor, which expands forever.
  local jumps: { [unknown]: number }, depths: { [unknown]: number } = {}, {}
  local active: { [unknown]: boolean } = {}
  local function measure(value: unknown): (number, number)
    if type(value) ~= 'table' then return 0, 0 end
    if jumps[value] then return jumps[value], depths[value] end
    if active[value] then return math.huge, math.huge end

    active[value] = true
    local total, deepest = 0, 0
    for _, edge in edges[value] or {} do
      local childJumps, childDepth = measure(edge.child)
      total += childJumps + (if edge.alias then 1 else 0)
      deepest = math.max(deepest, childDepth)
    end
    active[value] = nil

    local own = if kind(layout, value) == 'tagged' then 0 else 1
    jumps[value], depths[value] = total, deepest + own

    return total, deepest + own
  end

  local total, deepest = measure(root)

  return { events = events, jumps = total, depth = deepest }
end

local function shape(report: diagnostics.Report, path: string, where: string, expected: string)
  diagnostics.add(report, 'FORGE-E056', path, `{where} must be {expected}`, where)
end

local function read(report: diagnostics.Report, root: string, path: string): Workflow?
  local text, problem = fs.readFileString(fs.join(root, path))
  if not text then
    diagnostics.add(report, 'FORGE-E001', path, problem or 'unreadable')
    return nil
  end

  -- The decoder raises on a document that isn't YAML; that's a finding, not a crash.
  local parsed, decoded, layout = pcall(decodeWithLayout, text)
  if not parsed then
    diagnostics.add(report, 'FORGE-E002', path, tostring(decoded))
    return nil
  end

  local layoutOf = layout :: Layout
  local cost = budget(layoutOf, decoded)
  if cost.depth > MaxDepth then
    diagnostics.add(report, 'FORGE-E002', path, `recursion limit exceeded: {cost.depth} nested collections, past {MaxDepth}`)
    return nil
  end

  if cost.jumps > cost.events * JumpsPerEvent then
    diagnostics.add(report, 'FORGE-E002', path, `repetition limit exceeded: aliases expand {cost.jumps} times, past {cost.events * JumpsPerEvent}`)
    return nil
  end

  if type(untag(layoutOf, decoded)) ~= 'table' then
    diagnostics.add(report, 'FORGE-E002', path, 'a workflow is a mapping')
    return nil
  end

  -- A sequence has no name to get, which is how the Rust saw a list document.
  local document = lookup(layoutOf, decoded) or {}

  local action = fs.fileName(path) == 'action.yml'
  local id = if action
    then assert(string.match(path, '^.*/([^/]+)/action%.yml$'))
    else assert(string.match(path, '([^/]+)%.ya?ml$'))

  -- In the order the Rust's loader met them: the jobs as serde deserialized them, in the order the
  -- file wrote them; then each job's needs, in name order; then the name; then the contract.
  local jobs: { [string]: Job } = {}
  local jobsValue = untag(layoutOf, document.jobs)
  if not absent(jobsValue) and not isMapping(layoutOf, jobsValue) then
    shape(report, path, 'jobs', 'a mapping of job names')
  end

  local documents = mapping(layoutOf, jobsValue) or {}
  local written = if next(documents) then (layoutOf[documents].keys :: { string }) else {}
  for _, job in written do
    local value = untag(layoutOf, documents[job])
    if not absent(value) and not isMapping(layoutOf, value) then shape(report, path, `jobs.{job}`, 'a mapping') end

    local fields: { [string]: unknown } = mapping(layoutOf, value) or {}
    local steps = untag(layoutOf, fields.steps)
    if not absent(steps) and not isSequence(layoutOf, steps) then
      shape(report, path, `jobs.{job}.steps`, 'a list')
    end

    jobs[job] = { needs = {}, document = fields }
  end

  local names = sortedKeys(documents)
  for _, job in names do
    local needs = needed(layoutOf, jobs[job].document.needs)
    if not needs then
      diagnostics.add(report, 'FORGE-E052', path, 'needs is a job name or a list of them', `jobs.{job}`)
    end
    jobs[job].needs = needs or {}

    for _, dependency in jobs[job].needs do
      if not jobs[dependency] then
        diagnostics.add(report, 'FORGE-E051', path, `{id}/{job}: missing needed job {dependency}`, `jobs.{job}.needs`)
      end
    end
  end

  local name = untag(layoutOf, document.name)
  local named = type(name) == 'string'
  if not named then diagnostics.add(report, 'FORGE-E050', path, 'a workflow or action needs a name') end

  -- `on: { workflow_call: }` makes a reusable workflow even with nothing under it. The Rust war room
  -- asked this of actions too, and so does the forge.
  local on = lookup(layoutOf, document.on)
  local callable = on ~= nil and on.workflow_call ~= nil

  -- The contract is the action itself, or a workflow's workflow_call.
  local contract = if action then document else lookup(layoutOf, on and on.workflow_call)
  for _, key in { 'inputs', 'secrets', 'outputs' } do
    local value = contract and untag(layoutOf, contract[key])
    if not absent(value) and not isMapping(layoutOf, value) then shape(report, path, key, 'a mapping') end
  end

  if not named then return nil end

  -- An action's steps, when runs.steps is a list; anything else leaves it none, as in the Rust.
  local steps: { { [string]: unknown } } = {}
  local runs = lookup(layoutOf, document.runs)
  local listed = untag(layoutOf, runs and runs.steps)
  if isSequence(layoutOf, listed) then
    for _, step in listed :: { unknown } do
      local fields: { [string]: unknown } = lookup(layoutOf, step) or {}
      table.insert(steps, fields)
    end
  end

  return {
    id = id,
    path = path,
    name = name :: string,
    callable = callable,
    action = action,
    jobs = jobs,
    steps = steps,
    document = document,
    layout = layoutOf,
  }
end

--- Every workflow and action under `root`, in path order. Files that fail to read or parse are
--- reported and left out.
local function load(report: diagnostics.Report, root: string): { Workflow }
  local out = {}
  for _, path in paths(report, root) do
    local workflow = read(report, root, path)
    if workflow then table.insert(out, workflow) end
  end

  return out
end

--- The workflow or action with `id`.
local function find(workflows: { Workflow }, id: string): Workflow?
  for _, workflow in workflows do
    if workflow.id == id then return workflow end
  end

  return nil
end

--- Resolves `<workflow>/<job>` or `<action>/<step name>`; nil and a reason when it doesn't.
local function resolve(workflows: { Workflow }, reference: string): (Workflow?, string?)
  local id, name = string.match(reference, '^([^/]*)/(.*)$')
  if not id or not name then
    return nil, `{reference}: expected <workflow>/<job> or <action>/<step>`
  end

  local workflow = find(workflows, id)
  if not workflow then return nil, `{reference}: no workflow or action named {id}` end

  if workflow.action then
    for _, step in workflow.steps do
      if untag(workflow.layout, step.name) == name then return workflow, nil end
    end

    return nil, `{reference}: {id} has no step named {name}`
  end

  if workflow.jobs[name] then return workflow, nil end

  return nil, `{reference}: {id} has no job named {name}`
end

return table.freeze {
  kind = kind,
  untag = untag,
  lookup = lookup,
  isSequence = isSequence,
  load = load,
  find = find,
  resolve = resolve,
}
