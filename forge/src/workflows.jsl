--!strict
-- The workflows and composite actions as this checkout's YAML states them: every .yml and .yaml in
-- .github/workflows, and .github/actions/<id>/action.yml. A workflow's id is its file stem, an
-- action's its folder. Nothing here is recorded by hand; the war room's TOML refers to these.
local diagnostics = require './diagnostics'
local fs = require '@dream/fs'
local yaml = require '@jess/yaml'

export type Job = { needs: { string }, document: { [string]: unknown } }

export type Workflow = {
  id: string,
  path: string,
  name: string,
  callable: boolean,
  action: boolean,
  jobs: { [string]: Job },
  -- An action's steps, in order; a workflow has none of its own.
  steps: { { [string]: unknown } },
  document: { [string]: unknown },
}

local WorkflowFolder = '.github/workflows'
local ActionFolder = '.github/actions'

--- The repository-relative paths of every workflow and action file, sorted bytewise.
local function paths(report: diagnostics.Report, root: string): { string }
  local found = {}
  local names, problem = fs.list(fs.join(root, WorkflowFolder))
  if not names then
    diagnostics.add(report, 'FORGE-E001', WorkflowFolder, problem or 'unreadable')
  else
    for _, name in names do
      local extension = fs.extension(name)
      local path = `{WorkflowFolder}/{name}`
      if (extension == 'yml' or extension == 'yaml') and fs.isFile(fs.join(root, path)) then
        table.insert(found, path)
      end
    end
  end

  local actions, actionProblem = fs.list(fs.join(root, ActionFolder))
  if not actions then
    diagnostics.add(report, 'FORGE-E001', ActionFolder, actionProblem or 'unreadable')
  else
    for _, name in actions do
      local path = `{ActionFolder}/{name}/action.yml`
      if fs.isFile(fs.join(root, path)) then table.insert(found, path) end
    end
  end

  table.sort(found)

  return found
end

local function mapping(value: unknown): { [string]: unknown }?
  if type(value) ~= 'table' then return nil end

  return value :: { [string]: unknown }
end

local function list(value: unknown): { unknown }?
  if type(value) ~= 'table' then return nil end

  return value :: { unknown }
end

--- The job names `needs` lists, or nil when it isn't a name or a list of names.
local function needed(value: unknown): { string }?
  if value == nil or value == jess.null then return {} end
  if type(value) == 'string' then return { value } end

  local names = list(value)
  if not names or #names == 0 and next(names) ~= nil then return nil end

  local out = {}
  for _, name in names :: { unknown } do
    if type(name) ~= 'string' then return nil end
    table.insert(out, name)
  end

  return out
end

local function read(report: diagnostics.Report, root: string, path: string): Workflow?
  local text, problem = fs.readFileString(fs.join(root, path))
  if not text then
    diagnostics.add(report, 'FORGE-E001', path, problem or 'unreadable')
    return nil
  end

  -- yaml.decode raises on a document that isn't YAML; that's a finding, not a crash.
  local parsed, decoded = pcall(yaml.decode, text, nil)
  if not parsed then
    diagnostics.add(report, 'FORGE-E002', path, tostring(decoded))
    return nil
  end

  local document = mapping(decoded)
  if not document then
    diagnostics.add(report, 'FORGE-E002', path, 'a workflow is a mapping')
    return nil
  end

  local action = fs.fileName(path) == 'action.yml'
  local id = if action
    then assert(string.match(path, '^.*/([^/]+)/action%.yml$'))
    else assert(string.match(path, '([^/]+)%.ya?ml$'))

  local name = document.name
  if type(name) ~= 'string' then
    diagnostics.add(report, 'FORGE-E050', path, 'a workflow or action needs a name')
    return nil
  end

  -- `on: { workflow_call: }` makes a reusable workflow even with nothing under it.
  local on = mapping(document.on)
  local callable = not action and on ~= nil and on.workflow_call ~= nil

  local jobs: { [string]: Job } = {}
  local documents = mapping(document.jobs) or {}
  for job, value in documents do
    local fields = mapping(value) or {}
    local needs = needed(fields.needs)
    if not needs then
      diagnostics.add(report, 'FORGE-E052', path, 'needs is a job name or a list of them', `jobs.{job}`)
      needs = {}
    end
    jobs[job] = { needs = needs :: { string }, document = fields }
  end

  for job, entry in jobs do
    for _, dependency in entry.needs do
      if not jobs[dependency] then
        diagnostics.add(report, 'FORGE-E051', path, `{id}/{job}: missing needed job {dependency}`, `jobs.{job}.needs`)
      end
    end
  end

  local steps: { { [string]: unknown } } = {}
  local runs = mapping(document.runs)
  for _, step in (runs and list(runs.steps)) or {} do
    local fields: { [string]: unknown } = mapping(step) or {}
    table.insert(steps, fields)
  end

  return {
    id = id,
    path = path,
    name = name,
    callable = callable,
    action = action,
    jobs = jobs,
    steps = steps,
    document = document,
  }
end

--- Every workflow and action under `root`, in path order. Files that fail to read or parse are
--- reported and left out.
local function load(report: diagnostics.Report, root: string): { Workflow }
  local out = {}
  for _, path in paths(report, root) do
    local workflow = read(report, root, path)
    if workflow then table.insert(out, workflow) end
  end

  return out
end

--- The workflow or action with `id`.
local function find(workflows: { Workflow }, id: string): Workflow?
  for _, workflow in workflows do
    if workflow.id == id then return workflow end
  end

  return nil
end

--- Resolves `<workflow>/<job>` or `<action>/<step name>`; nil and a reason when it doesn't.
local function resolve(workflows: { Workflow }, reference: string): (Workflow?, string?)
  local id, name = string.match(reference, '^([^/]*)/(.*)$')
  if not id or not name then
    return nil, `{reference}: expected <workflow>/<job> or <action>/<step>`
  end

  local workflow = find(workflows, id)
  if not workflow then return nil, `{reference}: no workflow or action named {id}` end

  if workflow.action then
    for _, step in workflow.steps do
      if step.name == name then return workflow, nil end
    end

    return nil, `{reference}: {id} has no step named {name}`
  end

  if workflow.jobs[name] then return workflow, nil end

  return nil, `{reference}: {id} has no job named {name}`
end

return table.freeze {
  load = load,
  find = find,
  resolve = resolve,
}
