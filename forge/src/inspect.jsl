--!strict
-- `stroggforge.inspect/1`: the workflow and action contracts as JSON Lines. A header, then one line
-- per file in bytewise path order. Object keys are sorted and an empty mapping is written `[]`, as
-- the Rust war room's `inspect` wrote them through serde_json.
--
-- The Rust war room's `inspect` is the reference: docs/vnext/golden/workflow-contracts.jsonl.
-- @jess/yaml's layout says what the Lua tables can't (mapping or sequence, `1.0` or `1`), and
-- @jess/data/value writes JSON as serde_json does, so the two agree on what serde could write. Where
-- they still differ, the forge says so, and the suite pins each one:
--
-- - `010` is the integer 10, as YAML 1.2's core schema reads it, where serde_yaml read a string;
-- - a key written as a float with no fraction (`1.0: a`) is keyed `"1"`, where serde wrote `"1.0"`;
-- - a key serde_json refused (null, a collection) is FORGE-E057, where the Rust stopped with an error.
--
-- Unlike the Rust, which loaded the whole war room first, this reads only .github: it works on any
-- repository that has workflows.
local diagnostics = require './diagnostics'
local json = require '@jess/json'
local value = require '@jess/data/value'
local workflows = require './workflows'

local Schema = 'stroggforge.inspect/1'

type Layout = workflows.Layout
type Value = value.Value

local StepKeys = table.freeze { 'id', 'name', 'uses', 'if', 'shell', 'with', 'env', 'working-directory' }

local function unrepresentable(report: diagnostics.Report, path: string, where: string, what: string)
  diagnostics.add(report, 'FORGE-E057', path, `{what} has no JSON key`, if where == '' then nil else where)
end

--- A JSON object with `fields`' keys sorted bytewise, as serde_json's map keeps them; an empty one is
--- `[]`, as the Rust wrote every empty mapping.
local function object(fields: { [string]: Value }): Value
  local names = {}
  for name in fields do
    table.insert(names, name)
  end

  if #names == 0 then return value.array {} end

  table.sort(names)
  local pairs = {}
  for _, name in names do
    table.insert(pairs, { name, fields[name] })
  end

  return value.struct(pairs)
end

--- The JSON key serde_json wrote for a YAML mapping key, or nil where it refused one.
local function keyName(key: unknown): string?
  if type(key) == 'string' then return key end
  if type(key) == 'boolean' then return tostring(key) end
  if typeof(key) == 'integer' then return tostring(key) end

  if type(key) == 'number' and key == key and math.abs(key) ~= math.huge then
    if key == math.floor(key) and math.abs(key) < 2 ^ 53 then return string.format('%d', key) end

    -- serde_json writes a float key as it writes a float, `+` on a positive exponent included.
    return value.shortest(key, true)
  end

  return nil
end

local function describe(key: unknown): string
  if key == jess.null then return 'a null' end
  if type(key) == 'table' then return 'a collection' end

  return `a {typeof(key)}`
end

--- A decoded YAML value as serde_json wrote serde_yaml's: a NaN or infinity is null, a float stays a
--- float, a tag `!t` is `{"!t": value}` and a verbatim global tag is dropped, mapping keys become
--- strings. A key it couldn't write is reported and the mapping written as null.
local function canonical(layout: Layout, node: unknown, float: boolean, report: diagnostics.Report, path: string, where: string): Value
  if node == nil or node == jess.null then return value.Null end
  if type(node) == 'string' or type(node) == 'boolean' or typeof(node) == 'integer' then return node :: Value end

  if type(node) == 'number' then
    if node ~= node or math.abs(node) == math.huge then return value.Null end

    return if float then value.float(node) else node
  end

  local kind = workflows.kind(layout, node)
  if kind == 'tagged' then
    local tagged = node :: { tag: string, value: unknown }
    local inner = canonical(layout, tagged.value, false, report, path, where)
    if string.sub(tagged.tag, 1, 1) ~= '!' then return inner end

    return value.struct { { tagged.tag, inner } }
  end

  local entry = layout[node]
  if kind == 'sequence' then
    local out = {}
    for index, element in node :: { unknown } do
      out[index] = canonical(layout, element, entry.floats[index] == true, report, path, `{where}[{index}]`)
    end

    return value.array(out)
  end

  local fields: { [string]: Value } = {}
  for _, key in entry.keys :: { unknown } do
    local name = keyName(key)
    if not name then
      unrepresentable(report, path, where, `a mapping key that is {describe(key)}`)
      return value.Null
    end

    local child = (node :: { [unknown]: unknown })[key]
    fields[name] = canonical(layout, child, entry.floats[key] == true, report, path, if where == '' then name else `{where}.{name}`)
  end

  return object(fields)
end

--- `key` of a mapping as serde_yaml's get read it (through tags), written as serde_json wrote it, or
--- null when it's absent.
local function field(workflow: workflows.Workflow, container: unknown, key: string, report: diagnostics.Report, where: string): Value
  local mapping = workflows.lookup(workflow.layout, container)
  if not mapping then return value.Null end

  local entry = workflow.layout[mapping]
  local child = mapping[key]
  if child == nil then return value.Null end

  return canonical(workflow.layout, child, entry.floats[key] == true, report, workflow.path, where)
end

--- A step list as the Rust wrote it: only an untagged sequence, each step's contract fields and
--- whether it runs a script, never the script itself.
local function steps(workflow: workflows.Workflow, node: unknown, report: diagnostics.Report, where: string): Value
  local layout = workflow.layout
  if workflows.kind(layout, node) ~= 'sequence' then return value.array {} end

  local out = {}
  for index, step in node :: { unknown } do
    local fields: { [string]: Value } = {}
    local mapping = workflows.lookup(layout, step)
    for _, key in StepKeys do
      if mapping and mapping[key] ~= nil then fields[key] = field(workflow, step, key, report, `{where}[{index}].{key}`) end
    end
    fields.run = mapping ~= nil and mapping.run ~= nil
    table.insert(out, object(fields))
  end

  return value.array(out)
end

--- The event names `on` lists, sorted, whichever of its three spellings it uses. Like the Rust, it
--- matches the raw value: a tagged `on` lists none.
local function events(layout: Layout, on: unknown): Value
  local names = {}
  local kind = workflows.kind(layout, on)
  if type(on) == 'string' then
    table.insert(names, on)
  elseif kind == 'sequence' then
    for _, name in on :: { unknown } do
      if type(name) == 'string' then table.insert(names, name) end
    end
  elseif kind == 'mapping' then
    -- A mapping's string keys; the Rust skipped any other key.
    for _, key in layout[on].keys :: { unknown } do
      if type(key) == 'string' then table.insert(names, key) end
    end
  end
  table.sort(names)

  return value.array(names :: { any })
end

local function line(workflow: workflows.Workflow, report: diagnostics.Report): string
  local document = workflow.document
  local layout = workflow.layout
  local out: { [string]: Value } = {
    id = workflow.id,
    path = workflow.path,
    kind = if workflow.action then 'action' else 'workflow',
    name = workflow.name,
    callable = workflow.callable,
  }

  if workflow.action then
    out.inputs = field(workflow, document, 'inputs', report, 'inputs')
    out.outputs = field(workflow, document, 'outputs', report, 'outputs')
    out.using = field(workflow, document.runs, 'using', report, 'runs.using')
    local runs = workflows.lookup(layout, document.runs)
    out.steps = steps(workflow, runs and runs.steps, report, 'runs.steps')

    return json.encode(object(out))
  end

  local on = workflows.lookup(layout, document.on)
  local call = on and on.workflow_call
  out.events = events(layout, document.on)
  out.inputs = field(workflow, call, 'inputs', report, 'on.workflow_call.inputs')
  out.secrets = field(workflow, call, 'secrets', report, 'on.workflow_call.secrets')
  out.outputs = field(workflow, call, 'outputs', report, 'on.workflow_call.outputs')
  out.permissions = field(workflow, document, 'permissions', report, 'permissions')
  out.concurrency = field(workflow, document, 'concurrency', report, 'concurrency')
  out.env = field(workflow, document, 'env', report, 'env')

  -- Jobs as the Rust walked them: only an untagged mapping of them, and only an untagged mapping
  -- for each job's fields.
  local jobs: { [string]: Value } = {}
  local listed = document.jobs
  if workflows.kind(layout, listed) == 'mapping' then
    for name, job in listed :: { [string]: unknown } do
      local entry: { [string]: Value } = {}
      if workflows.kind(layout, job) == 'mapping' then
        local fields = job :: { [string]: unknown }
        for key, child in fields do
          local where = `jobs.{name}.{key}`
          entry[key] = if key == 'steps'
            then steps(workflow, child, report, where)
            else canonical(layout, child, layout[job].floats[key] == true, report, workflow.path, where)
        end
      end
      jobs[name] = object(entry)
    end
  end
  out.jobs = object(jobs)

  return json.encode(object(out))
end

--- The whole document for `loaded`, newline-terminated.
local function render(loaded: { workflows.Workflow }, report: diagnostics.Report): string
  local lines = { json.encode(object { schema = Schema, files = #loaded }) }
  for _, workflow in loaded do
    table.insert(lines, line(workflow, report))
  end

  return table.concat(lines, '\n') .. '\n'
end

return table.freeze {
  Schema = Schema,
  render = render,
  events = events,
  canonical = canonical,
}
